# === Base de datos ===
DB_URL=postgres://usuario:password@localhost:5432/carrito_db
PORT=3000

# === Seguridad JWT / Dashboard ===
# CAMBIAR en producción. Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=pon_aqui_un_secreto_muy_largo_y_aleatorio_min_64_chars
JWT_EXPIRES_IN=12h

# Credenciales únicas para acceder al Dashboard (login)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CambiaEstaPass123!

# === CORS ===
# Lista separada por comas de orígenes permitidos. Usa * solo en dev.
# Ejemplo local: http://localhost:5173 (Vite), http://localhost:3000, http://localhost:5500
# Ejemplo producción: https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500

# Si despliegas detrás de proxy (Render, Railway, Nginx), descomenta:
# NODE_ENV=production
