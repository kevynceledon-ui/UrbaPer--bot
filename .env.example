# === Base de datos ===
DB_URL=postgres://usuario:password@localhost:5432/carrito_db
PORT=3000

# === Seguridad JWT / Dashboard ===
# CAMBIAR en producción. Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=pon_aqui_un_secreto_muy_largo_y_aleatorio_min_64_chars
JWT_EXPIRES_IN=12h

# Credenciales únicas para acceder al Dashboard (login)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CambiaEstaPass123!

# === CORS ===
# Lista separada por comas de orígenes permitidos. Usa * solo en dev.
# Ejemplo local: http://localhost:5173 (Vite), http://localhost:3000, http://localhost:5500
# Ejemplo producción: https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500

# Si despliegas detrás de proxy (Render, Railway, Nginx), descomenta:
# NODE_ENV=production

# === Bot de WhatsApp ===
# Dirección del local, mostrada automáticamente a quien elige "retiro" en el bot.
DIRECCION_LOCAL=Tu dirección aquí, comuna

# === WhatsApp Cloud API (migración desde Baileys, ver plan de migración) ===
# "baileys" (default) usa la sesión no oficial de hoy; "cloud" usa la API
# oficial de Meta vía el webhook en src/routes/whatsappWebhook.ts. No dejar
# ambos transportes activos en producción a la vez.
WHATSAPP_TRANSPORT=baileys
# Del Meta Developer App (empezar con el número de prueba gratis, no el real):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# String propio, el que se configura también en el dashboard de Meta al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Nombre de la plantilla utility aprobada para avisar al staff (opcional, default "nuevo_pedido_alerta").
WHATSAPP_TEMPLATE_AVISO_STAFF=
